{
  "name": "site-docs",
  "version": "0.0.0",
  "private": true,
  "description": "docs.avunu.net: the documentation of every Avunu open-source project, built from each project's docs/ folder (a git submodule) into one site.",
  "homepage": "https://docs.avunu.net",
  "bugs": "https://github.com/Avunu/site-docs/issues",
  "license": "MIT",
  "author": "Avunu LLC (https://avunu.net)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Avunu/site-docs.git"
  },
  "type": "module",
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('build',{recursive:true,force:true})\"",
    "format": "oxfmt -c .oxfmtrc.json .",
    "format:check": "oxfmt -c .oxfmtrc.json --check .",
    "lint": "oxlint -c .oxlintrc.json .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "docs:build": "node build/cli.js build",
    "docs:check": "node build/cli.js check"
  },
  "dependencies": {
    "@jxsuite/compiler": "8.5.0",
    "@jxsuite/parser": "4.3.3",
    "@jxsuite/runtime": "6.2.2",
    "@jxsuite/search": "0.5.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "ajv": "8.20.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
